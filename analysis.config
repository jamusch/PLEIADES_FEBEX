for $SSID1 in 100 200
	for $i in [0:3]
		processor kinpex$SSID1/febex$i std.tuple(trace[16],filter[16],amplitude[16])
			trace[0:15]  <- kinpex_$SSID1.febex$i[0:15].trace
			filter[0:15] <- kinpex_$SSID1.febex$i[0:15].filter
			amplitude[0:15] <- kinpex_$SSID1.febex$i[0:15].amplitude
			waveform  trace 3000 persistent  in trace
			histogram trace 16384,0,16384   in resolution
			histogram amplitude 4000, 0 ,4000 in energy
		end
	end
end

processor daq/rate std.tuple(time,events)
	time <- event.time
	events <- event.number
	ratemeter events:time
end

### standard wr stitcher histograms:
for $SSID1 in 100 200
	for $SSID2 in 100 200
		processor anl/timestamp_difference_$SSID1_$SSID2 std.calc(dT=(T2_high-T1_high)*4294967296+(T2_low-T1_low))
			T1_low  <- kinpex_$SSID1.wr_time.low
			T1_high <- kinpex_$SSID1.wr_time.high
			T2_low  <- kinpex_$SSID2.wr_time.low
			T2_high <- kinpex_$SSID2.wr_time.high
			histogram dT 20000,-10000,10000  in timestamp_difference
		end
	end
end


# need this to invoke our factory !
# later loop over febex and channels here
processor go4output Go4OutputEvent

