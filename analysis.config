using std
using eel


crate stitching
	module sticher eel.WRTimeEventStitcher(1,100) # 1us window, new_procid=SSID*100+procid
end


for $SSID1 in 100 200
	crate kinpex_$SSID1
		procid {$SSID1+1} # SSID + procid from original event (which is 1)
		module wr_time eel.WRTime
		module febexparams eel.FEBEX34_PARAMS
		for $i in [0:3]
			module febex$i      eel.FEBEX34(1,$i)
		end
	end
end


####### without stitcher for single kinpex:
