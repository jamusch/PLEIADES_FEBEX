## map all existing components
	for $SSID1 in 100 200
		for $slave in [0:3]
			for $c in [0:15]
			    TPLEIADESRawEvent_TPLEIADESFebBoard({%02,($SSID1/100-1)*4+$slave})_TPLEIADESFebChannel({%02,$c})_fRFPGAEnergy <- kinpex_$SSID1.febex$slave[$c].amplitude
				TPLEIADESRawEvent_TPLEIADESFebBoard({%02,($SSID1/100-1)*4+$slave})_TPLEIADESFebChannel({%02,$c})_fRTrace[0]   <- kinpex_$SSID1.febex$slave[$c].trace
				TPLEIADESRawEvent_TPLEIADESFebBoard({%02,($SSID1/100-1)*4+$slave})_TPLEIADESFebChannel({%02,$c})_fRTraceBLR[0] <- kinpex_$SSID1.febex$slave[$c].trace
				TPLEIADESRawEvent_TPLEIADESFebBoard({%02,($SSID1/100-1)*4+$slave})_TPLEIADESFebChannel({%02,$c})_fRBIBOXTrace[0] <- kinpex_$SSID1.febex$slave[$c].trace
				TPLEIADESRawEvent_TPLEIADESFebBoard({%02,($SSID1/100-1)*4+$slave})_TPLEIADESFebChannel({%02,$c})_fRMWDTrace[0] <- kinpex_$SSID1.febex$slave[$c].trace
			end
		end
	end



end

